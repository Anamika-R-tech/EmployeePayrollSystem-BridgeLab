<!DOCTYPE html>
<html>
<head>
    <title>Employee Payroll</title>
    <link rel="stylesheet" href="/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
</head>
<body>

<!-- HEADER -->
<div class="header">
    <h1><i class="fa-solid fa-user"></i> Employee Payroll</h1>
</div>

<!-- SECTION BAR -->
<div class="section-box">
    <h2>Employee Details</h2>
    <button onclick="openModal()">
        <i class="fa-solid fa-user-plus"></i> Add User
    </button>
</div>

<!-- SUMMARY -->
<%
    let totalSalary = 0;
    let totalTax = 0;
    employees.forEach(emp => {
        totalSalary += emp.salary;
        totalTax += emp.salary * 0.12;
    });
    let avgSalary = employees.length ? totalSalary / employees.length : 0;
%>

<div class="summary">
    <div class="card">
        <i class="fa-solid fa-users icon blue"></i>
        <p>Total Employees</p>
        <h3><%= employees.length %></h3>
    </div>

    <div class="card">
        <i class="fa-solid fa-money-bill-wave icon green"></i>
        <p>Total Salary</p>
        <h3>₹ <%= totalSalary.toFixed(2) %></h3>
    </div>

    <div class="card">
        <i class="fa-solid fa-file-invoice-dollar icon red"></i>
        <p>Total Tax</p>
        <h3>₹ <%= totalTax.toFixed(2) %></h3>
    </div>

    <div class="card">
        <i class="fa-solid fa-chart-line icon purple"></i>
        <p>Average Salary</p>
        <h3>₹ <%= avgSalary.toFixed(2) %></h3>
    </div>
</div>

<!-- TABLE -->
<table>
<tr>
    <th>Name</th>
    <th>Gender</th>
    <th>Salary</th>
    <th>Tax</th>
    <th>Net Salary</th>
    <th>Actions</th>
</tr>

<% employees.forEach(emp => { 
    let tax = emp.salary * 0.12;
    let net = emp.salary - tax;
%>

<tr>
    <td><%= emp.name %></td>
    <td><%= emp.gender %></td>
    <td>₹ <%= emp.salary %></td>
    <td>₹ <%= tax.toFixed(2) %></td>
    <td>₹ <%= net.toFixed(2) %></td>
    <td>
        <a href="/edit/<%= emp.id %>" class="edit">
            <i class="fa-solid fa-pen"></i>
        </a>
        <a href="/delete/<%= emp.id %>" class="delete" onclick="return confirm('Delete?')">
            <i class="fa-solid fa-trash"></i>
        </a>
    </td>
</tr>

<% }) %>
</table>

<!-- MODAL -->
<div id="modal" class="modal">
<div class="modal-content">
    <span class="close" onclick="closeModal()">&times;</span>
    <h2><i class="fa-solid fa-user"></i> Add Employee</h2>

    <form action="/add" method="POST">

        <div class="input-group">
            <i class="fa-solid fa-user"></i>
            <input type="text" name="name" placeholder="Name" required>
        </div>

        <div class="input-group">
            <i class="fa-solid fa-indian-rupee-sign"></i>
            <input type="number" name="salary" placeholder="Salary" required>
        </div>

        <div class="input-group">
            <i class="fa-solid fa-venus-mars"></i>
            <select name="gender" required>
                <option value="">Select Gender</option>
                <option>Male</option>
                <option>Female</option>
                <option>Other</option>
            </select>
        </div>

        <button type="submit" class="save">
            <i class="fa-solid fa-floppy-disk"></i> Save
        </button>
    </form>
</div>
</div>

<script>
function openModal(){
    document.getElementById("modal").style.display = "flex";
}
function closeModal(){
    document.getElementById("modal").style.display = "none";
}
</script>

</body>
</html>
