<!DOCTYPE html>
<html>
<head>
    <title>Employee Payroll Dashboard</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>

<h1>Employee Payroll Dashboard</h1>

<a href="/add">Add New Employee</a>

<table>
    <thead>
        <tr>
            <th>ID</th>
            <th>Name</th>
            <th>Department</th>
            <th>Basic Salary</th>
            <th>Tax (10%)</th>
            <th>Net Salary</th>
        </tr>
    </thead>
    <tbody>
        <% employees.forEach(emp => { %>
            <tr>
                <td><%= emp.id %></td>
                <td><%= emp.name %></td>
                <td><%= emp.department %></td>
                <td>₹ <%= emp.basicSalary %></td>
                <td>₹ <%= emp.tax %></td>
                <td>₹ <%= emp.netSalary %></td>
            </tr>
        <% }) %>
    </tbody>
</table>

</body>
</html>
